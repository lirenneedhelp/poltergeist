// __HAUNT_NAME__ popup. Generated by scripts/new-haunt.mjs.
// Talks only to the service worker. It reads the active tab's id and nothing
// else from the tab, so it needs no "tabs" permission. All text is set with
// textContent.

// Kept in sync with MESSAGE in background.js. Importing background.js here would
// register a second set of worker listeners inside the popup page.
export const POPUP_MESSAGE = Object.freeze({
  POPUP_STATE: '__HAUNT_NAME__:popup-state',
  SET_PAUSED: '__HAUNT_NAME__:set-paused',
  SET_DEMO: '__HAUNT_NAME__:set-demo',
});

export const TEXT = Object.freeze({
  loading: 'Checking this tab…',
  active: 'Active on this tab.',
  demo: 'Active on this tab. Demo mode is on (thresholds ÷ 60 from the next page load).',
  paused: 'Paused on this tab.',
  error: 'Could not reach Poltergeist. Close and reopen this popup.',
  saveFailed: 'Could not save that change. Try again.',
});

const isObject = (v) => v !== null && typeof v === 'object' && !Array.isArray(v);
const isTabId = (v) => Number.isInteger(v) && v >= 0;

/**
 * Build the popup controller around injected Chrome and DOM objects so tests can
 * drive it. Nothing runs until init() is called.
 */
export function createPopup({ chrome: chromeApi, document: doc }) {
  const el = {
    status: doc.getElementById('status'),
    pause: doc.getElementById('pause'),
    demo: doc.getElementById('demo'),
  };
  const state = { phase: 'loading', tabId: null, paused: false, demoMode: false, saveFailed: false };

  async function send(message) {
    try {
      const reply = await chromeApi.runtime.sendMessage(message);
      return isObject(reply) ? reply : { ok: false, error: 'no response' };
    } catch {
      return { ok: false, error: 'no response' };
    }
  }

  function render() {
    let key = state.phase;
    if (state.phase === 'ready') key = state.paused ? 'paused' : state.demoMode ? 'demo' : 'active';
    el.status.dataset.state = state.saveFailed ? 'error' : key;
    el.status.textContent = state.saveFailed ? TEXT.saveFailed : TEXT[key];
    el.pause.checked = state.paused;
    el.demo.checked = state.demoMode;
    el.pause.disabled = state.phase !== 'ready';
    el.demo.disabled = state.phase !== 'ready';
  }

  async function activeTabId() {
    try {
      const tabs = await chromeApi.tabs.query({ active: true, currentWindow: true });
      const id = Array.isArray(tabs) && isObject(tabs[0]) ? tabs[0].id : undefined;
      return isTabId(id) ? id : null;
    } catch {
      return null;
    }
  }

  async function load() {
    state.phase = 'loading';
    render();
    const tabId = await activeTabId();
    const reply = tabId === null ? null : await send({ type: POPUP_MESSAGE.POPUP_STATE, tabId });
    if (!reply || reply.ok !== true || typeof reply.paused !== 'boolean' || typeof reply.demoMode !== 'boolean') {
      state.phase = 'error';
      render();
      return;
    }
    Object.assign(state, { phase: 'ready', tabId, paused: reply.paused, demoMode: reply.demoMode });
    render();
  }

  /** Send the change at once so it is stored even if the popup closes right after. */
  async function changePaused(paused) {
    if (state.phase !== 'ready' || typeof paused !== 'boolean') { render(); return; }
    const reply = await send({ type: POPUP_MESSAGE.SET_PAUSED, tabId: state.tabId, paused });
    state.saveFailed = !(reply.ok === true && reply.paused === paused);
    if (!state.saveFailed) state.paused = paused;
    render(); // on failure the box rolls back to the stored value
  }

  async function changeDemo(enabled) {
    if (state.phase !== 'ready' || typeof enabled !== 'boolean') { render(); return; }
    const reply = await send({ type: POPUP_MESSAGE.SET_DEMO, enabled });
    state.saveFailed = !(reply.ok === true && reply.demoMode === enabled);
    if (!state.saveFailed) state.demoMode = enabled;
    render();
  }

  function init() {
    el.pause.addEventListener('change', () => changePaused(el.pause.checked));
    el.demo.addEventListener('change', () => changeDemo(el.demo.checked));
    doc.getElementById('controls')?.addEventListener('submit', (event) => event.preventDefault());
    return load();
  }

  return { init, load, changePaused, changeDemo, render, state };
}

// Guarded bootstrap: runs only on the real extension page, not when imported by tests.
if (globalThis.chrome?.runtime?.id && globalThis.chrome?.tabs?.query && typeof document !== 'undefined') {
  const start = () => { void createPopup({ chrome: globalThis.chrome, document }).init(); };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start, { once: true });
  else start();
}
