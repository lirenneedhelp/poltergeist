// Starter package tests for __HAUNT_NAME__. Generated by scripts/new-haunt.mjs.
import { describe, it, expect } from 'vitest';
import { readFileSync } from 'node:fs';
import vm from 'node:vm';
import { fileURLToPath } from 'node:url';
import { validatePackage } from '../../scripts/validate-app-package.mjs';
import { validateRules, builtinEffects } from '../skeleton/index.js';

const REPO_ROOT = fileURLToPath(new URL('../../', import.meta.url));
const read = (rel) => readFileSync(fileURLToPath(new URL(`../${rel}`, import.meta.url)), 'utf8');
const RULES = JSON.parse(read('rules.json'));

/** Run content.js in a VM context without `chrome`, so only its top-level functions load. */
function loadContentScript() {
  const context = vm.createContext({ console });
  vm.runInContext(read('content.js'), context, { filename: 'content.js' });
  return context;
}

describe('__HAUNT_NAME__ package', () => {
  it('passes the Generic_Validator', async () => {
    const result = await validatePackage(REPO_ROOT, { key: '__HAUNT_NAME__', dir: '__APP_DIR__' });
    expect(result.errors).toEqual([]);
    expect(result.ok).toBe(true);
  });

  it('has rules.json that validates against the skeleton', () => {
    const result = validateRules(RULES, builtinEffects);
    expect(result.errors).toEqual([]);
    expect(result.valid).toBe(true);
  });

  it('builds the demo profile by dividing every threshold and rampTo by 60 without mutating the input', () => {
    const { hauntCreateDemoProfile } = loadContentScript();
    expect(typeof hauntCreateDemoProfile).toBe('function');
    const before = JSON.stringify(RULES);
    // JSON round trip: the result comes from another VM realm.
    const demo = JSON.parse(JSON.stringify(hauntCreateDemoProfile(RULES)));
    expect(JSON.stringify(RULES)).toBe(before);
    expect(demo.rules).toHaveLength(RULES.rules.length);
    RULES.rules.forEach((rule, i) => {
      expect(demo.rules[i].trigger.threshold).toBe(rule.trigger.threshold / 60);
      if (typeof rule.trigger.rampTo === 'number') expect(demo.rules[i].trigger.rampTo).toBe(rule.trigger.rampTo / 60);
      else expect(demo.rules[i].trigger.rampTo).toBeUndefined();
      expect(demo.rules[i].effect).toEqual(rule.effect);
    });
    expect(validateRules(demo, builtinEffects).valid).toBe(true);
  });
});
