// Starter service-worker tests for __HAUNT_NAME__. Generated by scripts/new-haunt.mjs.
import { describe, it, expect, beforeEach } from 'vitest';
import { MESSAGE, PAUSE_KEY_PREFIX, DEMO_KEY, pauseKey, createBackground } from '../background.js';

const EXT_ID = 'ext-id';
const BASE = `chrome-extension://${EXT_ID}/`;
const popupSender = { id: EXT_ID, url: `${BASE}popup.html` };
const contentSender = (tabId) => ({ id: EXT_ID, tab: { id: tabId }, url: 'https://example.com/' });

/** In-memory chrome.storage area. */
function makeArea() {
  const data = {};
  return {
    data,
    async get(key) { return key in data ? { [key]: data[key] } : {}; },
    async set(obj) { Object.assign(data, obj); },
    async remove(key) { delete data[key]; },
  };
}

function makeChrome() {
  const sent = [];
  return {
    sent,
    storage: { session: makeArea(), local: makeArea() },
    tabs: { async sendMessage(tabId, message, options) { sent.push({ tabId, message, options }); return { ok: true }; } },
    runtime: { id: EXT_ID, getURL: (p = '') => `${BASE}${p}` },
  };
}

let chromeApi;
let bg;
beforeEach(() => {
  chromeApi = makeChrome();
  bg = createBackground(chromeApi);
});

describe('__HAUNT_NAME__ service worker', () => {
  it('prefixes every storage key with the haunt name', () => {
    expect(PAUSE_KEY_PREFIX).toBe('__HAUNT_NAME__.pausedTab.');
    expect(DEMO_KEY).toBe('__HAUNT_NAME__.demoMode');
    expect(pauseKey(7)).toBe('__HAUNT_NAME__.pausedTab.7');
  });

  it('stores pause from an extension page and returns it to that tab', async () => {
    const res = await bg.handleMessage({ type: MESSAGE.SET_PAUSED, tabId: 5, paused: true }, popupSender);
    expect(res.ok).toBe(true);
    expect(chromeApi.storage.session.data[pauseKey(5)]).toBe(true);
    expect(chromeApi.sent).toEqual([
      { tabId: 5, message: { type: MESSAGE.APPLY_PAUSED, paused: true }, options: { frameId: 0 } },
    ]);
    expect(await bg.handleMessage({ type: MESSAGE.CONTENT_STATE }, contentSender(5)))
      .toEqual({ ok: true, paused: true, demoMode: false });
    expect((await bg.handleMessage({ type: MESSAGE.CONTENT_STATE }, contentSender(6))).paused).toBe(false);
  });

  it('stores Demo_Mode and returns it in content-state', async () => {
    const res = await bg.handleMessage({ type: MESSAGE.SET_DEMO, enabled: true }, popupSender);
    expect(res.ok).toBe(true);
    expect(chromeApi.storage.local.data[DEMO_KEY]).toBe(true);
    expect(await bg.handleMessage({ type: MESSAGE.CONTENT_STATE }, contentSender(1)))
      .toEqual({ ok: true, paused: false, demoMode: true });
  });

  it('rejects control messages from a content-script sender and leaves storage unchanged', async () => {
    const sender = contentSender(1);
    expect((await bg.handleMessage({ type: MESSAGE.SET_PAUSED, tabId: 1, paused: true }, sender)).ok).toBe(false);
    expect((await bg.handleMessage({ type: MESSAGE.SET_DEMO, enabled: true }, sender)).ok).toBe(false);
    expect((await bg.handleMessage({ type: MESSAGE.POPUP_STATE, tabId: 1 }, sender)).ok).toBe(false);
    expect(chromeApi.storage.session.data).toEqual({});
    expect(chromeApi.storage.local.data).toEqual({});
    expect(chromeApi.sent).toEqual([]);
  });

  it('treats storage read errors as not paused and Demo_Mode off', async () => {
    chromeApi.storage.session.get = async () => { throw new Error('session unavailable'); };
    chromeApi.storage.local.get = async () => { throw new Error('local unavailable'); };
    expect(await bg.handleMessage({ type: MESSAGE.CONTENT_STATE }, contentSender(2)))
      .toEqual({ ok: true, paused: false, demoMode: false });
  });
});
