// __HAUNT_NAME__ content script (classic, isolated world, top frame only).
// Generated by scripts/new-haunt.mjs.
//
// Chrome loads content scripts as classic scripts, so the ES-module skeleton is
// loaded later with a dynamic import of a runtime URL. This file has no static
// module declarations. It works on the whole page through the skeleton's
// effects and never looks up the site's own elements.

/**
 * Build the Demo_Profile: a deep clone of the rules document whose trigger
 * `threshold` and `rampTo` are divided by 60. The input is not mutated.
 * Accepts `{ rules: [...] }` or a bare rule array, like the validator.
 */
function hauntCreateDemoProfile(doc) {
  const DEMO_TIME_SCALE = 60;
  const demo = typeof structuredClone === 'function'
    ? structuredClone(doc)
    : JSON.parse(JSON.stringify(doc));
  const rules = Array.isArray(demo) ? demo : demo && Array.isArray(demo.rules) ? demo.rules : [];
  for (const rule of rules) {
    const trigger = rule && rule.trigger;
    if (!trigger || typeof trigger !== 'object') continue;
    if (typeof trigger.threshold === 'number') trigger.threshold /= DEMO_TIME_SCALE;
    if (typeof trigger.rampTo === 'number') trigger.rampTo /= DEMO_TIME_SCALE;
  }
  return demo;
}

void (async function bootHaunt() {
  const chromeApi = globalThis.chrome;
  if (!chromeApi || !chromeApi.runtime || !chromeApi.runtime.id) return;

  const LOG_PREFIX = '[poltergeist:__HAUNT_NAME__]';
  const MSG = {
    CONTENT_STATE: '__HAUNT_NAME__:content-state',
    APPLY_PAUSED: '__HAUNT_NAME__:apply-paused',
  };

  const reported = new Set();
  function reportOnce(kind, message, error) {
    if (reported.has(kind)) return;
    reported.add(kind);
    try {
      const detail = error && typeof error.message === 'string' ? error.message : undefined;
      if (detail) console.error(LOG_PREFIX, message, detail);
      else console.error(LOG_PREFIX, message);
    } catch {
      // Diagnostics must never throw.
    }
  }

  // Pause state for this tab. A live message wins over the initial reply.
  let paused = false;
  let pausedFromMessage = false;
  let runner = null;

  // 1. Register the message listener before asking for the initial state.
  chromeApi.runtime.onMessage.addListener((message, sender, sendResponse) => {
    if (!message || typeof message !== 'object') return false;
    if (!sender || sender.id !== chromeApi.runtime.id) return false;
    if (message.type !== MSG.APPLY_PAUSED) return false;
    if (typeof message.paused !== 'boolean') {
      sendResponse({ ok: false, error: 'paused must be a Boolean' });
      return false;
    }
    paused = message.paused;
    pausedFromMessage = true;
    runner?.setPaused(paused);
    sendResponse({ ok: true });
    return false;
  });

  // 2. Initial state. Any failure or malformed reply means not paused and Demo_Mode off.
  // Demo_Mode is read once, here; a change applies on the next page load.
  let demoMode = false;
  try {
    const reply = await chromeApi.runtime.sendMessage({ type: MSG.CONTENT_STATE });
    if (reply && reply.ok === true) {
      if (!pausedFromMessage) paused = reply.paused === true;
      demoMode = reply.demoMode === true;
    } else {
      reportOnce('state', 'could not read the initial state; running unpaused with normal timing');
    }
  } catch (error) {
    reportOnce('state', 'could not read the initial state; running unpaused with normal timing', error);
  }

  // 3. Load the skeleton and the rules from the extension package.
  let api;
  let profile;
  try {
    const [loaded, response] = await Promise.all([
      import(chromeApi.runtime.getURL('skeleton/index.js')),
      fetch(chromeApi.runtime.getURL('rules.json')),
    ]);
    if (!response || !response.ok) {
      throw new Error(`rules.json request failed (HTTP ${response ? response.status : 'none'})`);
    }
    const normal = await response.json();
    profile = demoMode ? hauntCreateDemoProfile(normal) : normal;
    const result = loaded.validateRules(profile, loaded.builtinEffects);
    if (!result || !result.valid) {
      const errors = result && Array.isArray(result.errors) ? result.errors.join('; ') : 'unknown error';
      throw new Error(`rules are invalid: ${errors}`);
    }
    api = loaded;
  } catch (error) {
    reportOnce('load', 'could not load the haunt', error);
    return;
  }

  // 4. The runner owns at most one live haunt for this page.
  let ghost = null;
  runner = {
    setPaused(p) {
      if (p) {
        if (!ghost) return;
        const current = ghost;
        ghost = null;
        try {
          current.stop(); // every effect undoes, leaving the page as it was
        } catch (error) {
          reportOnce('stop', 'stopping the haunt failed', error);
        }
        return;
      }
      if (ghost) return;
      try {
        // No initialMeters: time on site counts from 0 after a pause.
        ghost = api.startPoltergeist({ rules: profile });
      } catch (error) {
        ghost = null;
        reportOnce('start', 'starting the haunt failed', error);
      }
    },
  };
  runner.setPaused(paused);
}());
