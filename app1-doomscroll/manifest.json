{
  "manifest_version": 3,
  "name": "Poltergeist: Doomscroll Decay",
  "version": "0.1.0",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://x.com/*",
    "https://www.instagram.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://x.com/*",
        "https://www.instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "rules.json",
        "skeleton/index.js",
        "skeleton/engine.js",
        "skeleton/meters.js",
        "skeleton/match.js",
        "skeleton/validator.js",
        "skeleton/effects/index.js",
        "skeleton/effects/util.js",
        "skeleton/effects/fog.js",
        "skeleton/effects/flicker.js",
        "skeleton/effects/rot.js",
        "skeleton/effects/block.js"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://x.com/*",
        "https://www.instagram.com/*"
      ],
      "use_dynamic_url": false
    }
  ]
}
