{
  "$id": "poltergeist/rule-schema.json",
  "title": "Poltergeist rule file",
  "description": "A rules.json file: either an array of rules or an object with a 'rules' array. Time meters are in seconds, scrollDistance is in pixels. JSON Schema draft-07 style.",
  "oneOf": [
    { "type": "array", "items": { "$ref": "#/definitions/rule" } },
    {
      "type": "object",
      "required": ["rules"],
      "additionalProperties": false,
      "properties": {
        "rules": { "type": "array", "items": { "$ref": "#/definitions/rule" } }
      }
    }
  ],
  "definitions": {
    "rule": {
      "type": "object",
      "required": ["id", "match", "trigger", "effect", "undo"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "description": { "type": "string" },
        "enabled": { "type": "boolean", "default": true },
        "match": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "description": "Chrome match pattern, e.g. *://*.example.com/*, or <all_urls>" }
        },
        "trigger": {
          "type": "object",
          "required": ["meter", "threshold"],
          "additionalProperties": false,
          "properties": {
            "meter": { "enum": ["timeOnSite", "scrollDistance", "timeSinceActive"] },
            "threshold": { "type": "number", "minimum": 0, "description": "Rule fires when meter >= threshold" },
            "rampTo": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Meter value at which intensity reaches 1. Must be > threshold. Omit for a flat intensity of 1."
            }
          }
        },
        "effect": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string" },
            "params": { "type": "object" }
          }
        },
        "undo": {
          "type": "object",
          "required": ["mode"],
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["instant", "fade"] },
            "durationMs": { "type": "integer", "minimum": 0, "maximum": 10000 }
          }
        }
      }
    }
  }
}
